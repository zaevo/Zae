# Leave the Supabase values empty to run in demo mode (sample data, no real money).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe: Connect (worker payouts) + Issuing (virtual cards) + Billing (memberships)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio: A2P 10DLC-registered Messaging Service for dispatch SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Background checks (Checkr, pay-per-report)
CHECKR_API_KEY=

# Credit data furnisher partner (receives Metro 2 files; you do not send to bureaus directly)
FURNISHER_API_URL=
FURNISHER_API_KEY=

# Claude API: bill negotiator (Next.js) and outreach drafting (scraper)
ANTHROPIC_API_KEY=
